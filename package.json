{
  "name": "cricketiq-backend",
  "version": "1.0.0",
  "description": "Cricvora Node.js backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:worker": "node worker.js",
    "dev:server": "nodemon server.js",
    "dev:worker": "nodemon worker.js",
    "dev": "concurrently --names SERVER,WORKER --prefix-colors cyan,yellow \"npm run dev:server\" \"npm run dev:worker\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "axios": "1.14.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.5.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-cache": "^5.1.2",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "nodemon": "^3.1.0"
  }
}
