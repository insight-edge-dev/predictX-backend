PORT=5000

# Demo account (Google Play reviewer — non-production only)
DEMO_PHONE=+91XXXXXXXXXX
DEMO_OTP=XXXXXX

# Sportsmonks Cricket API (primary data source)
SPORTMONKS_API_KEY=your_sportmonks_api_key

# Cricbuzz RapidAPI (news + player rankings)
CRICBUZZ_API_KEY=your_rapidapi_key

# Football — free-api-live-football-data (RapidAPI)
APIFOOTBALL_KEY=your_rapidapi_key

# Football — API-Football v3 (api-sports.io direct)
APIFOOTBALL_V3_KEY=your_apisports_key

# Football — football-data.org (free tier)
FOOTBALL_DATA_ORG_TOKEN=your_football_data_org_token

# IPL configuration
IPL_SEASON=2026
IPL_SEASON_ID=XXXX
IPL_STAGE_ID=XXXX
IPL_PLAYOFF_ID=XXXX

# Admin panel
ADMIN_KEY=your_admin_key
ADMIN_USER=admin
ADMIN_PASS=your_admin_password
# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Android SMS Retriever hash
ANDROID_APP_HASH=your_app_hash

# JWT secret (min 64 chars, random hex)
JWT_SECRET=your_jwt_secret_64_chars_minimum

# Custom SMS provider
SMS_API_KEY=your_sms_api_key
SMS_CAMPAIGN_ID=XXXXX
SMS_ROUTE_ID=X
SMS_SENDER_ID=XXXXXX

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
